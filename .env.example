# Copy this file to `.env` and fill in your keys.
#   cp .env.example .env
#
# `.env` is gitignored. Everything here is optional — with none of it set the
# app runs on synthetic data and answers questions straight from the ledger.

# Razorpay test-mode keys.
# Dashboard -> switch to Test Mode -> Account & Settings -> API Keys.
# The secret is shown only once when you generate it.
RAZORPAY_KEY_ID=rzp_test_TWuV41Kz0AiIvF

RAZORPAY_KEY_SECRET=toxxbS2eCejfRPU887OhL75i

# Model key for the settlement Q&A. Either provider works — the grounding is
# in the retrieval layer, not in which model answers. Set ONE of these.
# Without either, questions are answered directly from the match ledger.
#
# Anthropic — console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx
#
# Gemini — aistudio.google.com/apikey (free tier available)
GEMINI_API_KEY=AIzaxxxxxxxxxxxxx
# GEMINI_MODEL=gemini-2.0-flash        # optional; auto-detected if unset
