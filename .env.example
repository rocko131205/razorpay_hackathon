# Copy this file to `.env` and fill in your keys.
#   cp .env.example .env
#
# `.env` is gitignored. Everything here is optional — with none of it set the
# app runs on synthetic data and answers questions straight from the ledger.

# Razorpay test-mode keys.
# Dashboard -> switch to Test Mode -> Account & Settings -> API Keys.
# The secret is shown only once when you generate it.
RAZORPAY_KEY_ID=rzp_test_TWuV41Kz0AiIvF

RAZORPAY_KEY_SECRET=toxxbS2eCejfRPU887OhL75i

# Anthropic key for the settlement Q&A. console.anthropic.com -> API Keys.
# Without it, questions are answered directly from the match ledger.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx
