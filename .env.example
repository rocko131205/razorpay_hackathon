# Copy to `.env` and fill in. `.env` is gitignored.
#   cp .env.example .env
#
# Everything here is optional. With none of it set the app runs on synthetic
# data and answers questions straight from the match ledger.

# Razorpay test mode. Dashboard -> Test Mode -> Account & Settings -> API Keys.
# The secret is shown only once, when you generate it.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxx

# Model for the settlement Q&A. Set ONE — either works, because the grounding
# lives in the retrieval layer rather than in which model answers.
#
# Gemini — aistudio.google.com/apikey (free tier available)
GEMINI_API_KEY=AIzaxxxxxxxxxxxxx
# GEMINI_MODEL=gemini-2.5-flash       # optional; auto-detected if unset
#
# Anthropic — console.anthropic.com -> API Keys
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx
